{
  "manifest_version": 3,
  "name": "Browser Buddy",
  "version": "1.0.0",
  "description": "A focused browser companion for YouTube and tab hygiene.",
  "permissions": ["storage", "tabs"],
  "host_permissions": ["*://*.youtube.com/*"],
  "action": { "default_popup": "popup.html", "default_title": "Browser Buddy" },
  "background": { "service_worker": "background.js" },
  "content_scripts": [{
    "matches": ["*://*.youtube.com/*"],
    "js": ["content.js"],
    "run_at": "document_end"
  }]
}
