{
  "manifest_version": 3,
  "name": "Browser Buddy",
  "version": "1.3.0",
  "description": "A focused browser companion for YouTube and tab hygiene.",
  "permissions": ["storage", "tabs"],
  "host_permissions": [
    "*://*.youtube.com/*",
    "*://*.amazon.com/*", "*://*.amazon.ca/*", "*://*.amazon.com.mx/*", "*://*.amazon.com.br/*", "*://*.amazon.co.uk/*", "*://*.amazon.de/*", "*://*.amazon.fr/*", "*://*.amazon.es/*", "*://*.amazon.it/*", "*://*.amazon.nl/*", "*://*.amazon.se/*", "*://*.amazon.pl/*", "*://*.amazon.com.tr/*", "*://*.amazon.ae/*", "*://*.amazon.sa/*", "*://*.amazon.eg/*", "*://*.amazon.in/*", "*://*.amazon.sg/*", "*://*.amazon.com.au/*", "*://*.amazon.co.jp/*", "*://*.amazon.com.be/*", "*://*.amazon.ie/*", "*://*.amazon.co.za/*"
  ],
  "action": { "default_popup": "popup.html", "default_title": "Browser Buddy" },
  "background": { "service_worker": "background.js" },
  "content_scripts": [{
    "matches": [
      "*://*.youtube.com/*",
      "*://*.amazon.com/*", "*://*.amazon.ca/*", "*://*.amazon.com.mx/*", "*://*.amazon.com.br/*", "*://*.amazon.co.uk/*", "*://*.amazon.de/*", "*://*.amazon.fr/*", "*://*.amazon.es/*", "*://*.amazon.it/*", "*://*.amazon.nl/*", "*://*.amazon.se/*", "*://*.amazon.pl/*", "*://*.amazon.com.tr/*", "*://*.amazon.ae/*", "*://*.amazon.sa/*", "*://*.amazon.eg/*", "*://*.amazon.in/*", "*://*.amazon.sg/*", "*://*.amazon.com.au/*", "*://*.amazon.co.jp/*", "*://*.amazon.com.be/*", "*://*.amazon.ie/*", "*://*.amazon.co.za/*"
    ],
    "exclude_matches": ["*://music.youtube.com/*"],
    "js": ["lib/languages.js", "lib/caption-style.js", "lib/settings.js", "lib/touch.js", "content.js"],
    "run_at": "document_end"
  }, {
    "matches": ["*://*.youtube.com/*"],
    "exclude_matches": ["*://music.youtube.com/*"],
    "js": ["lib/touch.js", "lib/quality.js", "lib/languages.js", "lib/caption-track.js", "lib/caption-style.js", "lib/audio-track.js", "page-bridge.js"],
    "world": "MAIN",
    "run_at": "document_start"
  }]
}
